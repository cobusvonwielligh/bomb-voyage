[Unit]
Description=Bomb Voyage game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/bomb-voyage
EnvironmentFile=/etc/bomb-voyage.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=2

# Bind 443 and 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/bomb-voyage

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bomb-voyage

[Install]
WantedBy=multi-user.target
