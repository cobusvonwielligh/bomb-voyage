[Unit]
Description=Bomb Voyage game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/bomb-voyage
# All configuration lives in /opt/bomb-voyage/config.ini, which is gitignored and never rsynced.
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=2

# Bind 443 and 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# ec2-user can sudo anything, so this is what stops a hole in the game becoming root on the box.
# It is also why infra/self-update.sh restarts the service by signalling it rather than via sudo.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/bomb-voyage /opt/bomb-voyage

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bomb-voyage

[Install]
WantedBy=multi-user.target
