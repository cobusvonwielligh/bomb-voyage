{
  "name": "bomb-voyage",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "description": "16-player browser Bomberman for Friday office games",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tag": "npm version minor -m \"release: v%s\" && git push --follow-tags",

    "start": "node server/index.js",
    "dev": "LAG=200 JITTER=40 node server/index.js",
    "test": "node --test",
    "preview": "node -e \"require('child_process').spawn(process.platform==='darwin'?'open':'xdg-open',['http://localhost:8080/art-preview.html'])\"",
    "deploy": "./infra/deploy.sh",
    "deploy:fast": "SKIP_TESTS=1 ./infra/deploy.sh",
    "rollback": "./infra/rollback.sh",
    "logs": "./infra/logs.sh",
    "bots": "node server/bots.js",
    "botbench": "node server/botbench.js"
  },
  "dependencies": {
    "@fails-components/webtransport": "^1.6.11",
    "@fails-components/webtransport-transport-http3-quiche": "^1.6.11",
    "ws": "^8.18.0"
  }
}
