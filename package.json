{
  "name": "bomb-voyage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "16-player browser Bomberman for Friday office games",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "LAG=200 JITTER=40 node server/index.js",
    "test": "node --test",
    "preview": "node -e \"require('child_process').spawn(process.platform==='darwin'?'open':'xdg-open',['http://localhost:8080/art-preview.html'])\"",
    "deploy": "./infra/deploy.sh",
    "deploy:fast": "SKIP_TESTS=1 ./infra/deploy.sh",
    "rollback": "./infra/rollback.sh",
    "logs": "./infra/logs.sh"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
